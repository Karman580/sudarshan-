# ==============================================================================
# SUDARSHAN AI - .gitignore File
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# macOS / System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project outputs & temporary files
temp/
outputs/
*.log
git_inspect_temp/

# Exclude large training checkpoints (>50MB), but KEEP production weight files
v2_balanced/checkpoints/*_full.pth

# Build releases
releases/
